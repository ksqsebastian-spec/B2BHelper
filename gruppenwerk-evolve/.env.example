# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Verschlüsselung für API-Keys (32 Byte Hex-String)
# Generieren: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-32-byte-hex-string-here

# Login-Passwort (frei waehlbar, nur serverseitig)
LOGIN_PASSWORD=dein-sicheres-passwort
